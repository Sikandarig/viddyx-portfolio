{
    "version": 3,
    "buildCommand": "npm run build",
    "outputDirectory": "dist/public",
    "functions": {
      "api/index.ts": { "runtime": "nodejs20.x" }
    },
    "routes": [
      { "src": "/api/(.*)", "dest": "/api/index.ts" },
      { "handle": "filesystem" },
      { "src": "/(.*)", "dest": "/$1" }
    ]
  }
  