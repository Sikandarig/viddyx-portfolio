{
    "version": 2,
    "builds": [
      { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist/public" } }
    ],
    "routes": [
      { "src": "/(.*)\\.(css|js|png|jpg|jpeg|gif|svg|ico|woff2?)", "dest": "/$1.$2" },
      { "src": "/(.*)", "dest": "/index.html" }
    ]
  }
  